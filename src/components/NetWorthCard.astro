---
import { netWorth, totalAssets, loan, byType, history, money, short, pct, payoff, fmtMonth } from '../lib/sample';
import Icon from './Icon.astro';
const delta = netWorth - history[history.length - 2].total;
const sinceLabel = new Date(history[history.length - 2].date).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long' });
// Donut: 4 segments with small gaps, drawn on one circle.
const R = 46, C = 2 * Math.PI * R, GAP = 2.5;
let offset = 0;
const segs = byType.map(t => { const len = Math.max(0, t.share * C - GAP); const s = { ...t, len, offset: -offset }; offset += t.share * C; return s; });
const ariaDonut = 'Assets by type: ' + byType.map(t => `${t.label} ${pct(t.share)}`).join(', ');
const loanEnd = payoff(loan.balance, loan.monthly, loan.rate);
---
<article class="card nw" aria-label="Net worth" data-nw data-loan={loan.balance}>
  <div class="top">
    <div>
      <div class="label">Total net worth · NZD</div>
      <div class="amount"><span class="cur">NZ$</span><span data-nw-num>{Math.round(netWorth).toLocaleString('en-NZ')}</span></div>
      <div class="delta" data-nw-late>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2.5 10 8H2z" fill="var(--pos)" /></svg>
        <b class="num">{money(delta)}</b> since {sinceLabel}
      </div>
      <div class="sum" data-nw-late><span>Assets <b>{money(totalAssets)}</b></span><span>Liabilities <b>{money(loan.balance)}</b></span></div>
    </div>
    <div class="donut-wrap">
      <svg class="donut" viewBox="0 0 120 120" role="img" aria-label={ariaDonut}>
        <g transform="rotate(-90 60 60)">
          <circle cx="60" cy="60" r={R} stroke="var(--border)" />
          {segs.map(s => <circle cx="60" cy="60" r={R} style={`stroke:var(${s.token})`} stroke-dasharray={`${s.len.toFixed(1)} ${C.toFixed(1)}`} stroke-dashoffset={s.offset.toFixed(1)} data-seg={s.key} data-len={s.len.toFixed(1)} data-value={s.value} data-c={C.toFixed(1)} />)}
        </g>
      </svg>
      <ul class="legend" aria-hidden="true">
        {byType.map(t => <li data-leg={t.key}><i style={`background:var(${t.token})`}></i><span>{t.label}</span><small><em class="amt">{short(t.value)} · </em>{pct(t.share)}</small></li>)}
      </ul>
    </div>
  </div>
  <ul class="rows">
    <li class="row" data-row-for="funds"><span class="ico" style="--c:var(--type-funds)"><Icon name="trend" size={16} /></span><div><div class="name">KiwiSaver Growth</div><div class="meta">Unit trusts</div></div><div class="val">NZ$38,650</div></li>
    <li class="row" data-row-for="cash"><span class="ico" style="--c:var(--type-cash)"><Icon name="globe" size={16} /></span><div><div class="name">Savings in Colombo</div><div class="meta">Cash · live rate</div></div><div class="val">LKR 1,000,000<small data-fx>≈ NZ$5,500</small></div></li>
    <li class="row" data-row-for="other"><span class="ico" style="--c:var(--type-other)"><Icon name="car" size={16} /></span><div><div class="name">2019 hatchback</div><div class="meta">Revalues from age and kms</div></div><div class="val">NZ$14,300</div></li>
    <li class="row" data-row-for="loan"><span class="ico" style="--c:var(--muted)"><Icon name="card" size={16} /></span><div><div class="name">Car loan</div><div class="meta">Paid off <span data-loan-months={loanEnd.months}>{fmtMonth(loanEnd.end)}</span></div></div><div class="val">{money(-loan.balance)}</div></li>
  </ul>
</article>

<script>
  // The hero's one authored moment: the total assembles. The donut draws type by type while the
  // number counts up through the assets, each account row arrives with its type, then the loan
  // lands and the number counts down to net worth. The HTML is the finished state; this only
  // rewinds it right before playing, so a failed script or reduced motion shows the final card.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || new URLSearchParams(location.search).get('motion') === 'off';
  const card = document.querySelector<HTMLElement>('[data-nw]');
  if (card && !reduce && 'IntersectionObserver' in window) {
    const root = document.documentElement;
    root.dataset.heroAssembled = 'pending';
    const num = card.querySelector<HTMLElement>('[data-nw-num]')!;
    const segs = [...card.querySelectorAll<SVGCircleElement>('[data-seg]')];
    const loan = +card.dataset.loan!;
    const fmt = (v: number) => Math.round(v).toLocaleString('en-NZ');
    const out = (k: number) => 1 - Math.pow(1 - k, 4);                 // quart ease-out: confident arrival
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const STEP = 380, SEG = 560, LOAN_AT = segs.length * STEP + 260, LOAN = 620, LATE_AT = LOAN_AT + LOAN - 60, END = LATE_AT + 420;

    const done = () => { root.dataset.heroAssembled = 'done'; card.removeAttribute('data-anim'); num.style.minWidth = ''; num.style.display = ''; document.dispatchEvent(new Event('sf:hero-assembled')); };
    const finalText = num.textContent!;
    const rewind = () => {
      card.setAttribute('data-anim', '');
      segs.forEach(c => c.setAttribute('stroke-dasharray', `0 ${c.dataset.c}`));
      num.textContent = '0';
    };
    const play = () => {
      // Reserve the final width (measured now that the web fonts are in) so nothing shifts while digits change.
      num.textContent = finalText; num.style.display = 'inline-block';
      num.style.minWidth = num.getBoundingClientRect().width + 'px'; num.textContent = '0';
      const t0 = performance.now(), fired = new Set<string>();
      const once = (key: string, fn: () => void) => { if (!fired.has(key)) { fired.add(key); fn(); } };
      const frame = (now: number) => {
        const t = now - t0;
        let total = 0;
        segs.forEach((c, i) => {
          const k = out(clamp((t - i * STEP) / SEG));
          c.setAttribute('stroke-dasharray', `${(+c.dataset.len! * k).toFixed(2)} ${c.dataset.c}`);
          total += +c.dataset.value! * k;
          if (t >= i * STEP) once(c.dataset.seg!, () => {
            card.querySelector(`[data-leg="${c.dataset.seg}"]`)?.classList.add('in');
            card.querySelector(`[data-row-for="${c.dataset.seg}"]`)?.classList.add('in');
          });
        });
        if (t >= LOAN_AT) once('loan', () => card.querySelector('[data-row-for="loan"]')!.classList.add('in'));
        total -= loan * out(clamp((t - LOAN_AT) / LOAN));
        num.textContent = fmt(total);
        if (t >= LATE_AT) once('late', () => card.classList.add('settled'));
        if (t < END) requestAnimationFrame(frame); else done();
      };
      requestAnimationFrame(frame);
    };
    rewind();
    const io = new IntersectionObserver(entries => {
      if (!entries.some(e => e.isIntersecting)) return;
      io.disconnect();
      (document.fonts?.ready ?? Promise.resolve()).then(() => setTimeout(play, 200));
    }, { threshold: 0.35 });
    io.observe(card);
  }
</script>

<style>
  .nw { padding: 32px 32px 12px; }
  .top { display: flex; gap: 28px; align-items: center; justify-content: space-between; }
  .amount { white-space: nowrap; margin-top: 6px; font-family: var(--font-num); font-weight: 600; font-size: clamp(2.6rem, 2rem + 2.2vw, 3.9rem); line-height: 1; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  .cur { font-size: .58em; letter-spacing: -0.02em; color: var(--text-2); vertical-align: .36em; margin-right: 2px; }
  .delta { margin-top: 12px; display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--muted); }
  .delta b { color: var(--pos); font-weight: 600; }
  .sum { margin-top: 14px; display: flex; gap: 18px; font-size: 13.5px; color: var(--muted); flex-wrap: wrap; }
  .sum b { color: var(--text); font-weight: 600; font-family: var(--font-num); }
  .donut-wrap { display: flex; align-items: center; gap: 20px; flex: none; }
  .donut { width: 132px; height: 132px; flex: none; }
  .donut circle { fill: none; stroke-width: 14; }
  .legend { list-style: none; display: grid; gap: 9px; font-size: 13px; }
  .legend li { display: grid; grid-template-columns: 10px auto; column-gap: 8px; align-items: center; }
  .legend i { width: 8px; height: 8px; border-radius: 50%; }
  .legend span { color: var(--text-2); font-weight: 500; }
  .legend small { grid-column: 2; font-family: var(--font-num); font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .legend em { font-style: normal; }
  .rows { list-style: none; margin: 28px -32px 0; border-top: 1px solid var(--border); }
  .row { display: grid; grid-template-columns: 30px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 14px 32px; border-bottom: 1px solid var(--border); }
  .row:last-child { border-bottom: 0; }
  .ico { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }
  .name { font-weight: 600; font-size: 14.5px; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meta { font-size: 12.5px; color: var(--muted); margin-top: 1px; }
  .val { text-align: right; font-family: var(--font-num); font-weight: 600; font-size: 15px; font-variant-numeric: tabular-nums; }
  .val small { display: block; font-weight: 500; font-size: 12px; color: var(--muted); }

  /* Assembly sequence (only while data-anim is set by the script) */
  .nw[data-anim] .row { opacity: 0; transform: translateY(10px); clip-path: inset(0 0 100% 0); transition: opacity 420ms var(--ease-out), transform 520ms cubic-bezier(0.16, 1, 0.3, 1), clip-path 520ms cubic-bezier(0.16, 1, 0.3, 1); }
  .nw[data-anim] .row:global(.in) { opacity: 1; transform: none; clip-path: inset(0 0 0 0); }
  .nw[data-anim] [data-fx] { opacity: 0; filter: blur(5px); transform: translateY(-3px); transition: opacity 360ms var(--ease-out) 300ms, filter 420ms var(--ease-out) 300ms, transform 420ms var(--ease-out) 300ms; }
  .nw[data-anim] .row:global(.in) [data-fx] { opacity: 1; filter: none; transform: none; }
  .nw[data-anim] .legend li { opacity: .3; transition: opacity 320ms var(--ease-out); }
  .nw[data-anim] .legend li:global(.in) { opacity: 1; }
  .nw[data-anim] [data-nw-late] { opacity: 0; transform: translateY(4px); transition: opacity 380ms var(--ease-out), transform 380ms var(--ease-out); }
  .nw[data-anim]:global(.settled) [data-nw-late] { opacity: 1; transform: none; }
  @media (max-width: 760px) {
    .nw { padding: 22px 20px 4px; }
    .top { flex-direction: column; align-items: flex-start; gap: 22px; }
    .donut-wrap { width: 100%; gap: 16px; }
    .donut { width: 88px; height: 88px; }
    .legend { flex: 1; grid-template-columns: 1fr 1fr; gap: 10px 12px; }
    .legend .amt { display: none; }
    .rows { margin: 20px -20px 0; }
    .row { padding: 13px 20px; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 10px; }
  }
</style>
