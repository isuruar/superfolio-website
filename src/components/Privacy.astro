---
import Icon from './Icon.astro';
const points = [
  { icon: 'noAd', title: 'No ads, ever', body: 'There’s nothing on the screen but your money.' },
  { icon: 'shield', title: 'We don’t sell your data', body: 'Or share it, or rent it out. It’s yours.' },
  { icon: 'bag', title: 'Nothing to sell you', body: 'No commissions from banks, funds or lenders, so no reason to steer you.' },
  { icon: 'lock', title: 'No bank login', body: 'You type the numbers in. There are no bank passwords to hand over.' },
  { icon: 'eyeOff', title: 'Privacy mode', body: 'Hide every amount with one tap when someone’s looking over your shoulder.' },
  { icon: 'download', title: 'Your backups', body: 'Download a full backup whenever you like, and restore it just as easily.' },
];
---
<section class="band" id="privacy" aria-labelledby="privacy-title">
  <div class="wrap">
    <div class="head">
      <p class="label">Private by design</p>
      <h2 id="privacy-title">Your money is your business. <span class="quiet">Ours is the app.</span></h2>
      <p class="lead">Superfolio is free while in beta. It has no ads and nothing to sell you, so it has no reason to collect more than it needs.</p>
    </div>
    <ul class="grid">
      {points.map(p => <li><Icon name={p.icon} size={22} /><h3>{p.title}</h3><p>{p.body}</p></li>)}
    </ul>
    <p class="site-note"><Icon name="check" size={18} /> This website has no analytics, no cookies and no trackers.</p>
  </div>
</section>

<style>
  .band { background: var(--inverse-bg); color: var(--inverse-text); padding-block: calc(var(--section-gap) + 8px); margin-bottom: var(--section-gap); }
  .head { max-width: 42rem; display: grid; gap: var(--space-4); }
  .label { color: var(--inverse-muted); }
  h2 { font-size: var(--text-h2); font-weight: 600; line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
  .quiet { display: block; color: var(--inverse-muted); }
  .lead { font-size: var(--text-lead); color: var(--inverse-muted); }
  .grid { list-style: none; margin-top: var(--space-8); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--inverse-border); border: 1px solid var(--inverse-border); border-radius: var(--r-lg); overflow: hidden; }
  .grid li { background: var(--inverse-bg); padding: 28px; display: grid; gap: 8px; align-content: start; }
  .grid :global(svg) { color: var(--inverse-text); margin-bottom: 8px; }
  h3 { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; }
  .grid p { color: var(--inverse-muted); font-size: 15px; }
  .site-note { margin-top: var(--space-6); display: flex; gap: 8px; align-items: center; font-size: 14px; color: var(--inverse-muted); }
  .band :global(:focus-visible) { outline-color: var(--inverse-text); }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .band { padding-block: var(--section-gap); } .grid { grid-template-columns: minmax(0, 1fr); } .grid li { padding: 22px; } }
</style>
