---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found · Superfolio">
  <Nav />
  <main id="main" class="wrap nf">
    <h1>That page isn’t here.</h1>
    <p>The link may be old, or the address may have a typo.</p>
    <a class="btn btn-primary" href="/">Back to the home page</a>
  </main>
  <Footer />
</Base>
<style>
  .nf { padding-block: var(--space-10); display: grid; gap: var(--space-4); justify-items: start; }
  h1 { font-size: var(--text-h2); font-weight: 600; letter-spacing: var(--tracking-heading); }
  p { color: var(--text-2); }
</style>
